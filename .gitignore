## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoAutoGenerated)
mono_crash.*

# Build results
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# Tye
.tye/

# Visual Studio cache/options
.vs/
.vscode/

# Visual Studio for Mac
*.userprefs

# Build results (VS)
*_i.c
*_p.c
*_h.h
*.ilk
*.meta
*.obj
*.pch
*.pdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*.log
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc

# Chutzpah Test files
_Chutzpah*

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Build Results of an ATL Project
[Dd]ebugPS/
[Rr]eleasePS/
dlldata.c

# BenchmarkDotNet Artifacts
BenchmarkDotNet.Artifacts/

# .NET Core dotnet-watch
dotnet-watch.json

# StyleCop
StyleCopReport.xml

# Files built by Visual Studio
*_i.asm
*_pdb.c
*.idb
*.pgc
*.pgd
*.tmp
*.dbmdl
*.bak
*.backup
*.ldf
*.ndf

# Others
*.dbmdl
*.jfm
*.pfx
*.publishsettings

# Ignore RIA/Silverlight projects
Generated_Code/

# Backup & report files from converting an old project file
*.UpgradeLog.*
Backup*/
UpgradeLog*.XML

# SQL Server files
*.mdf
*.ldf
*.ndf

# Business Intelligence projects
*.rdl.data
*.bim.layout
*.bim_*.settings
*.rptproj.rsuser
*- [Bb]ackup.rdl

# Microsoft Fakes
FakesAssemblies/

# Node.js Tools for Visual Studio
node_modules/

# Visual Studio 6 build log
*.plg

# Visual Studio 6 workspace options file
*.opt

# Visual Studio LightSwitch build output
GeneratedArtifacts/
_Pvt_Extensions/
ModelManifest.xml

# Package restore files
*.nuget.props
*.nuget.targets

# Windows image file caches
Thumbs.db
ehthumbs.db

# IIS Express
/.vs/ProjectName/config/applicationhost.config

# Windows Installer files
*.cab
*.msi
*.msm
*.msp

# Windows shortcuts
*.lnk

# Azure Functions local settings
local.settings.json
appsettings.Development.json

# DotCover
.idea/
*.dotCover

# JetBrains Rider
.idea/

# dotenv
.env
